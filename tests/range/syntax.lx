var r = 1..5;
var last = 5;
var start = 0;

print r;           // expect: 1..5
print start..last; // expect: 0..5

print r == r;           // expect: true
print 1..3 == 1..4;     // expect: false
print 1..3 == 1..3;     // expect: true
print 1..3 != 1..4;     // expect: true

// Empty ranges are falsy regardless of their bound.
print !!(1..1); // expect: false
print !!(2..2); // expect: false
print !!(0..0); // expect: false

// Forward and reversed non-empty ranges are truthy.
print !!(1..3); // expect: true
print !!(3..1); // expect: true
