// The inner break ends each inner loop; the outer break ends the for loop.
// @timeout: 2
// expect: 0
// expect: 1
// expect: 2
// expect: 10
// expect: 11
// expect: 12
// expect: done
for (var i in 0..3) {
  if (i == 2) break;
  var j = 0;
  loop {
    if (j == 3) break;
    print i * 10 + j;
    j = j + 1;
  }
}
print "done";
