// Each break site is reached on a different pass through the same loop.
// @timeout: 2
// expect: 0
// expect: 0
// expect: 1
var run = 0;
while (run < 2) {
  var i = 0;
  loop {
    if (run == 0 and i == 1) break;
    if (run == 1 and i == 2) break;
    print i;
    i = i + 1;
  }
  run = run + 1;
}
