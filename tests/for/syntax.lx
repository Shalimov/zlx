// Single-expression body.
for (var c in 1..=3) print c;
// expect: 1
// expect: 2
// expect: 3

// Block body.
for (var a in 0..3) {
  print a;
}
// expect: 0
// expect: 1
// expect: 2

// Return from the loop body.
fun foo() {
  for (var iteration in 0..1) return "done";
}
print foo(); // expect: done

// Upper bounds are re-evaluated before every iteration.
var end = 2;
for (var i in 0..end) {
  print i;
  end = end - 1;
}
// expect: 0

// Assigning the indexer affects the automatic increment.
for (var i in 0..4) {
  print i;
  i = i + 1;
}
// expect: 0
// expect: 2

// Statement bodies.
for (var i in 0..0) if (true) 1; else 2;
for (var i in 0..0) while (true) 1;
for (var i in 0..0) for (var j in 0..1) 1;
