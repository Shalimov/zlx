{
  var i = "before";

  // New variable is in inner scope.
  for (var i in 0..1) {
    print i; // expect: 0

    // Loop body is in second inner scope.
    var i = -1;
    print i; // expect: -1
  }
}

{
  // New variable shadows outer variable.
  for (var i in 0..0) {}

  // Goes out of scope after loop.
  var i = "after";
  print i; // expect: after

  // Loop variable can shadow an existing variable.
  for (var i in 0..1) {
    print i; // expect: 0
  }

  // Existing variable is unchanged after the loop.
  print i; // expect: after
}
